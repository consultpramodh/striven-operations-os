# Copy to .env.local for local development. Never commit real credentials.
STRIVEN_CLIENT_ID=
STRIVEN_CLIENT_SECRET=
STRIVEN_BASE_URL=https://api.striven.com

# Tenant-specific. Required by the first verified Task Search probe.
STRIVEN_ACCOUNT_ID=

# Keep Stage 0 payloads intentionally small.
STAGE0_PAGE_SIZE=1
