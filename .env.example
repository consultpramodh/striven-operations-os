# Copy to .env.local for local development. Never commit real credentials.
STRIVEN_CLIENT_ID=
STRIVEN_CLIENT_SECRET=
STRIVEN_BASE_URL=https://api.striven.com

# A known non-sensitive-to-code customer/account record ID used only for read-only discovery.
# Striven's Task Search field is named AccountID; this is NOT the Striven tenant identifier.
STRIVEN_PROBE_CUSTOMER_ID=

# Keep Stage 0 payloads intentionally small.
STAGE0_PAGE_SIZE=1
